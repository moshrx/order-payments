# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_, never commit.
# The anon key cannot be used: cash-flow's migration 007_lock_down_rls.sql
# revoked every anon privilege, so it returns 401 on all tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cash Flow API (server-only — the key must never reach the browser).
CASHFLOW_API_URL=https://your-cash-flow-deployment
CASHFLOW_API_KEY=your-partner-api-key
