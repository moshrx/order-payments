# Supabase → Project Settings → Data API (URL) and API Keys (anon / publishable key).
# EXPO_PUBLIC_ vars are readable in the app bundle, so only ever put the anon key here —
# never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
