# Supabase → Project Settings → Data API (URL) and API Keys (anon / publishable key).
# NEXT_PUBLIC_ vars are readable in the browser, so only ever put the anon key here —
# never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
