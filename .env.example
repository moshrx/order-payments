# Supabase → Project Settings → Data API (URL) and API Keys (anon / publishable key).
# NEXT_PUBLIC_ vars are readable in the browser, so only ever put the anon key here —
# never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cash Flow API (server-only — no NEXT_PUBLIC_ prefix, the key must never reach the browser).
CASHFLOW_API_URL=https://your-cash-flow-app.vercel.app
CASHFLOW_API_KEY=your-cashflow-api-key

# Admin password for /admin. Defaults to "root" if unset — change this for anything real.
ADMIN_PASSWORD=choose-a-strong-password
